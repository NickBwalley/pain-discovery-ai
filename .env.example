# Web: copy to .env.local. These are the only public keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Exact app origin for OAuth and email confirmation; HTTPS in production.
APP_URL=http://localhost:3000

# Server-only username lookup (web) and worker access. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Worker: copy to .env. The shared queue processes every confirmed user's jobs.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=YOUR_OPENROUTER_KEY
AI_MODEL=YOUR_STRUCTURED_OUTPUT_COMPATIBLE_MODEL
AI_PROVIDER=openrouter
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_CALLS_PER_RUN=10
HN_REQUEST_INTERVAL=0.25
